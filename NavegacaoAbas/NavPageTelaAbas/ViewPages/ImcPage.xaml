<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NavPageTelaAbas.ViewPages.ImcPage"
             BackgroundColor="#121212"
             Title="IMC">
    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="15" VerticalOptions="Center">
            <Label Text="IMC" 
                   FontSize="26" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" 
                   TextColor="#7C4DFF" />

            <Label Text="Peso (kg):" TextColor="#B388FF" />
            <Entry x:Name="TxtPeso" 
                   Placeholder="Ex: 70,5" 
                   Keyboard="Numeric" 
                   TextColor="White" 
                   PlaceholderColor="#666" />

            <Label Text="Altura (m):" TextColor="#B388FF" />
            <Entry x:Name="TxtAltura" 
                   Placeholder="Ex: 1,75" 
                   Keyboard="Numeric" 
                   TextColor="White" 
                   PlaceholderColor="#666" />

            <Button x:Name="BtnCalcularImc" 
                    Text="Revelar Diagnóstico 👻" 
                    Clicked="BtnCalcularImc_Clicked"
                    BackgroundColor="#7C4DFF" 
                    TextColor="White" 
                    FontAttributes="Bold" 
                    CornerRadius="12" 
                    HeightRequest="50" />

            <Label x:Name="LblMsg" 
                   FontSize="14" 
                   TextColor="#FF5252" 
                   HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>