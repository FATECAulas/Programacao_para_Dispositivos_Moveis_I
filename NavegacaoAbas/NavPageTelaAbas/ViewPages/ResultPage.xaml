<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NavPageTelaAbas.ViewPages.ResultPage"
             BackgroundColor="#F9F9F9"
             Title="Resultado">
    <VerticalStackLayout Padding="25" Spacing="20" VerticalOptions="Center">
        <Border Padding="20" 
                Stroke="#E65100" 
                StrokeThickness="1.5" 
                BackgroundColor="White" 
                StrokeShape="RoundRectangle 12">
            <VerticalStackLayout Spacing="12">
                <Label x:Name="LblTitulo" 
                       Text="Resultado 🎃" 
                       FontSize="22" 
                       FontAttributes="Bold" 
                       HorizontalOptions="Center" 
                       TextColor="#E65100" />
                <Label x:Name="LblOp" 
                       FontSize="18" 
                       TextColor="#555555" 
                       HorizontalOptions="Center" />
                <Label x:Name="LblRes" 
                       Text="0" 
                       FontSize="24" 
                       FontAttributes="Bold" 
                       TextColor="#333333" 
                       HorizontalOptions="Center" 
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Border>

        <Button x:Name="BtnVoltar" 
                Text="Voltar" 
                Clicked="BtnVoltar_Clicked"
                BackgroundColor="#E65100" 
                TextColor="White" 
                FontAttributes="Bold" 
                CornerRadius="10" 
                HeightRequest="45" />
    </VerticalStackLayout>
</ContentPage>